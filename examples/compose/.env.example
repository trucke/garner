# Settings and secrets of the Compose example. Copy this file to .env,
# fill it in and keep it private: chmod 600 .env

# Your time zone, such as Europe/Berlin.
TZ=Etc/UTC

# Uncomment to run the example's Jellyfin too.
#COMPOSE_PROFILES=jellyfin

# Garner's API keys. Leave JELLYFIN_API_KEY empty to run without Jellyfin.
# The image brings Garner's own TheTVDB key; to use your own, add
# TVDB_API_KEY.
PROWLARR_API_KEY=
SABNZBD_API_KEY=
JELLYFIN_API_KEY=
